{
  "name": "@daclify/modules",
  "version": "0.9.0-alpha.8",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.21 <25",
    "npm": ">=11.19 <12"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    "./archive/migrations": {
      "types": "./dist/archive/migrations.d.ts",
      "import": "./dist/archive/migrations.js"
    },
    "./archive": {
      "types": "./dist/archive/index.d.ts",
      "import": "./dist/archive/index.js"
    },
    ".": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./help": {
      "types": "./dist/protocol/generated/help.d.ts",
      "import": "./dist/protocol/generated/help.js"
    }
  },
  "files": [
    "migrations/archive",
    "dist/archive",
    "dist/protocol",
    "dist/sdk",
    "contracts/common",
    "docs/generated",
    "LICENSE",
    "LICENSING.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:contracts": "tsx tools/build.ts",
    "test": "vitest run",
    "codegen": "tsx tools/codegen.ts",
    "docs:generate": "tsx tools/docs/generate.ts",
    "docs:check": "tsx tools/docs/generate.ts --check",
    "lint": "tsx tools/lint.ts",
    "verify": "npm run lint && npm run typecheck && npm run docs:check && npm test",
    "format:check": "prettier --check \"**/*.{ts,vue,css,json,yml}\"",
    "format": "prettier --write \"**/*.{ts,vue,css,json}\""
  },
  "dependencies": {
    "@wharfkit/antelope": "4.0.2",
    "multiformats": "14.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@daclify/core-protocol": "file:../daclify-backend-core/.artifacts/daclify-core-protocol-0.10.0-alpha.1.tgz",
    "@proton/vert": "0.3.24",
    "@types/node": "24.19.1",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "es5-ext": false,
    "fsevents": false
  },
  "peerDependencies": {
    "@daclify/core-protocol": "0.10.0-alpha.1"
  }
}
